{
  "name": "volt-storm",
  "version": "1.0.0",
  "description": "16-bit horizontal scrolling shoot-em-up attract mode demo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:visual": "node test-visual.js",
    "test:pixel": "node test-pixel-analysis.js",
    "test:all": "npm run build && npm run test:visual && npm run test:pixel",
    "test:report": "node test-report.js"
  },
  "devDependencies": {
    "puppeteer": "^25.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "puppeteer@25.4.0": true
  }
}
