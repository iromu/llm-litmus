{
  "_documentation": "Alien Fortress biome encounter script. Defines 10 timed waves of enemy spawns for the alien fortress stage. Loaded by EncounterScript via libGDX JsonReader into EncounterData (biome + Array<WaveData>). Each wave triggers at its startTime and spawns enemies with staggered delays.",
  "_fields": {
    "biome": "Biome identifier string. Must match the biome name used by the game to select this encounter. Value: 'alien_fortress'.",
    "waves": "Array of wave objects. Ordered by startTime ascending. Each wave fires once when gameTime >= startTime.",
    "waves[].startTime": "Seconds into the encounter when this wave activates (float, >= 0). Waves are processed in order; typical spacing is 5 seconds between waves.",
    "waves[].spawns": "Array of spawn objects within this wave. Each spawn creates one enemy at the given position after its delay.",
    "waves[].spawns[].enemyType": "String matching an 'id' field in enemy_definitions.json (e.g. 'ghost', 'tank'). Must be a valid enemy type or spawn fails silently.",
    "waves[].spawns[].x": "Spawn X position in screen pixels (float, 0-640). Screen is 640x480. Values near 320 center the enemy; values near 0 or 640 spawn at edges.",
    "waves[].spawns[].y": "Spawn Y position in screen pixels (float, 0-480). Screen is 640x480. Values near 0 spawn at top; values near 480 spawn at bottom.",
    "waves[].spawns[].delay": "Seconds after wave startTime before this specific enemy spawns (float, >= 0). Enables staggered spawns within a single wave."
  },
