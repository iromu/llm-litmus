{
  "_documentation": "Enemy type definitions for the ThunderForce shoot-'em-up. Each entry defines a unique enemy type used across encounter waves. Loaded by AssetLoader via libGDX JsonReader into EnemyDefinitions wrapper (Array<EnemyData>). Call index() after loading to build O(1) lookup by id.",
  "_fields": {
    "enemies": "Array of enemy type objects. Each object must have a unique 'id' string used as the key in encounter spawn references.",
    "id": "Unique string identifier (e.g. 'grunt', 'tank'). Used by encounter JSON to reference this enemy type. Must match exactly (case-sensitive).",
    "sprite": "Relative path to the enemy sprite sheet PNG from the assets root (e.g. 'enemies/grunt.png'). Loaded by AssetLoader as a Texture.",
    "hp": "Hit points (integer, 1-15). Number of player bullets required to destroy. Higher HP enemies tend to have lower speed. Java type: int.",
    "speed": "Movement speed in pixels per second (float, 0-100). 0 means stationary (e.g. turret). Higher = faster lateral/vertical movement. Java type: float.",
    "behavior": "AI movement pattern. Valid values: zigzag, patrol, ambush, chase, retreat, formation_fly. Maps to Enemy.BehaviorType enum (ZIGZAG, PATROL, AMBUSH, CHASE, RETREAT, FORMATION_FLY).",
    "attackPattern": "Bullet firing pattern string. Valid values: straight, rapid, spread, aimed, heavy, circular, split, shielded, homing, charge, rotating, phase, burst, proximity, woven, heavy_spread, teleport, suicide, none. 'none' means the enemy does not fire bullets.",
    "score": "Points awarded when this enemy is destroyed (integer, 50-1000). Scales with enemy difficulty. Java type: int.",
    "dropsPowerUp": "Whether this enemy can drop a power-up on death (boolean). True enables random power-up drops; false means no drop.",
    "spawnX": "Default spawn X coordinate in screen pixels (float, 0-640). Screen is 640x480. Used as initial position when spawned from encounter waves.",
    "spawnY": "Default spawn Y coordinate in screen pixels (float, 0-480). Screen is 640x480. Used as initial position when spawned from encounter waves."
  },
