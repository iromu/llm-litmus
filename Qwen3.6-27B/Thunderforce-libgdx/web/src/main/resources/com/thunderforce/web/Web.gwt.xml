<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.11.0//EN"
        "http://www.gwtproject.org/doctype/2.11.0/gwt-module2.dtd">
<module rename-to="thunderforce">
    <source path="com/thunderforce/web" />
    <inherits name="com.badlogic.gdx.backends.gdx_backends_gwt" />

    <set-configuration-property name="devModeRedirectEnabled" value="true"/>

    <collapse-all-properties />
    <set-property name="user.agent" value="safari" />
    <collapse-property name="user.agent" values="*" />

    <entry-point class="com.thunderforce.web.client.GwtLauncher" />
</module>
